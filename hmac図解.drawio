  <diagram name="Page-1" id="KDBpzmpAyTIiXG7byymx">
    <mxGraphModel dx="2216" dy="934" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" value="HMAC署名つきWebhook ― なぜ「なりすまし」と「改ざん」を弾けるのか" vertex="1">
          <mxGeometry height="40" width="1420" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=13;fontStyle=2;align=center;fontColor=#555555;" value="前提：CMS(送信側) と 受信側 が「同じ秘密鍵 K」を事前に共有している（ネットワークには絶対に流さない）" vertex="1">
          <mxGeometry height="26" width="1420" x="120" y="58" as="geometry" />
        </mxCell>
        <mxCell id="senderBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=8;" value="① 送信側（CMS）が署名を作る" vertex="1">
          <mxGeometry height="470" width="420" x="120" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s_body" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;fontFamily=monospace;fontSize=12;spacingLeft=8;" value="記事更新イベントの本文(body)&#xa;{ &quot;id&quot;: &quot;article-42&quot;,&#xa;  &quot;version&quot;: 7,&#xa;  &quot;op&quot;: &quot;update&quot; }" vertex="1">
          <mxGeometry height="90" width="360" x="150" y="155" as="geometry" />
        </mxCell>
        <mxCell id="s_key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="🔑 秘密鍵 K（共有・非公開）" vertex="1">
          <mxGeometry height="40" width="360" x="150" y="270" as="geometry" />
        </mxCell>
        <mxCell id="s_hmac" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" value="HMAC-SHA256( K , body )&#xa;= ハッシュ計算（鍵を混ぜて要約）" vertex="1">
          <mxGeometry height="56" width="360" x="150" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s_sig" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=monospace;fontSize=12;" value="署名 = a1b2c3...（64文字の16進）&#xa;※ body から計算した「鍵つきの指紋」" vertex="1">
          <mxGeometry height="56" width="360" x="150" y="425" as="geometry" />
        </mxCell>
        <mxCell id="s_note" parent="1" style="text;html=1;align=left;fontSize=12;fontColor=#b85450;fontStyle=2;spacingLeft=8;" value="送るのは body と 署名 だけ。&#xa;🔑鍵 K は送らない（ここが①APIキー方式との決定的な差）" vertex="1">
          <mxGeometry height="60" width="360" x="150" y="500" as="geometry" />
        </mxCell>
        <mxCell id="se1" edge="1" parent="1" source="s_body" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" target="s_hmac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" edge="1" parent="1" source="s_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;" target="s_hmac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" edge="1" parent="1" source="s_hmac" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;" target="s_sig">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;" value="② ネットワークを流れるHTTPリクエスト" vertex="1">
          <mxGeometry height="220" width="360" x="600" y="230" as="geometry" />
        </mxCell>
        <mxCell id="net_http" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;fontFamily=monospace;fontSize=12;spacingLeft=8;" value="POST /webhook&#xa;X-Signature: a1b2c3...&#xa;&#xa;{ &quot;id&quot;:&quot;article-42&quot;, &quot;version&quot;:7,&#xa;  &quot;op&quot;:&quot;update&quot; }" vertex="1">
          <mxGeometry height="120" width="310" x="625" y="275" as="geometry" />
        </mxCell>
        <mxCell id="net_warn" parent="1" style="text;html=1;align=center;fontSize=11;fontColor=#b85450;fontStyle=2;" value="⚠️ 攻撃者はここを盗み見・改ざんできる&#xa;（でも🔑鍵Kは流れていないので作れない）" vertex="1">
          <mxGeometry height="36" width="360" x="600" y="405" as="geometry" />
        </mxCell>
        <mxCell id="edgeSend" edge="1" parent="1" source="senderBox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=3;endArrow=block;fontSize=12;fontStyle=1;" target="netBox" value="送信">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="recvBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=8;" value="③ 受信側が「自分でも署名を計算」して照合する" vertex="1">
          <mxGeometry height="470" width="520" x="1020" y="110" as="geometry" />
        </mxCell>
        <mxCell id="r_recv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontFamily=monospace;fontSize=12;" value="受け取った body と 署名(X-Signature)" vertex="1">
          <mxGeometry height="40" width="460" x="1050" y="155" as="geometry" />
        </mxCell>
        <mxCell id="r_key" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="🔑 同じ秘密鍵 K（受信側も持っている）" vertex="1">
          <mxGeometry height="36" width="460" x="1050" y="215" as="geometry" />
        </mxCell>
        <mxCell id="r_calc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="受け取った body から自分で再計算&#xa;HMAC-SHA256( K , 受け取ったbody ) = 期待署名" vertex="1">
          <mxGeometry height="56" width="460" x="1050" y="270" as="geometry" />
        </mxCell>
        <mxCell id="r_cmp" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" value="期待署名 == 受け取った署名 ?" vertex="1">
          <mxGeometry height="90" width="220" x="1170" y="350" as="geometry" />
        </mxCell>
        <mxCell id="r_ok" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" value="✅ 一致 → 本物のCMS &amp; 改ざんなし&#xa;→ pullして処理に進む" vertex="1">
          <mxGeometry height="80" width="230" x="1050" y="465" as="geometry" />
        </mxCell>
        <mxCell id="r_ng" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" value="❌ 不一致 → 偽物 or 改ざん&#xa;→ 401で拒否（捨てる）" vertex="1">
          <mxGeometry height="80" width="200" x="1310" y="465" as="geometry" />
        </mxCell>
        <mxCell id="re1" edge="1" parent="1" source="r_recv" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;" target="r_calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" edge="1" parent="1" source="r_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;" target="r_calc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re3" edge="1" parent="1" source="r_calc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;" target="r_cmp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re4" edge="1" parent="1" source="r_cmp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontStyle=1;" target="r_ok" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re5" edge="1" parent="1" source="r_cmp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontStyle=1;" target="r_ng" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edgeRecv" edge="1" parent="1" source="netBox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=3;endArrow=block;fontSize=12;fontStyle=1;" target="recvBox" value="受信">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="whyBox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=8;" value="なぜ防げるのか（3つの攻撃シナリオ）" vertex="1">
          <mxGeometry height="200" width="1420" x="120" y="620" as="geometry" />
        </mxCell>
        <mxCell id="why1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;fontSize=12;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="① なりすまし（偽CMSが偽Webhookを送る）&#xa;&#xa;🔑鍵Kが無いので正しい署名を作れない。&#xa;受信側の再計算と一致せず → ❌拒否。" vertex="1">
          <mxGeometry height="130" width="440" x="150" y="665" as="geometry" />
        </mxCell>
        <mxCell id="why2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;fontSize=12;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="② 改ざん（中間者がbodyを書き換える）&#xa;&#xa;bodyを1バイト変えると指紋が総崩れ。&#xa;でも鍵Kが無く署名を作り直せない。&#xa;再計算とズレる → ❌拒否（＝完全性）。" vertex="1">
          <mxGeometry height="130" width="440" x="620" y="665" as="geometry" />
        </mxCell>
        <mxCell id="why3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde0dc;strokeColor=#b85450;align=left;fontSize=12;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" value="③ リプレイ（正規リクエストを丸ごと再送）&#xa;&#xa;署名ごと盗めば①②は通ってしまう！&#xa;→ HMACだけでは防げない。&#xa;対策：timestampも署名対象に入れ&#xa;『5分より古い』を拒否 ＋ イベントID冪等化。" vertex="1">
          <mxGeometry height="130" width="420" x="1090" y="665" as="geometry" />
        </mxCell>
        <mxCell id="keypoint" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;fontStyle=1;fontSize=13;" value="核心：署名は「鍵を持つ者しか作れない／持つ者なら誰でも検証できる」鍵つきの指紋。&#xa;＝ 真正性（本物のCMSか）＋ 完全性（改ざんされてないか）を同時に保証する。鍵そのものは流れない。これがAPIキー方式に勝る理由。" vertex="1">
          <mxGeometry height="70" width="1420" x="120" y="850" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
